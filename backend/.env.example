MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Elvee
ADMIN_EMAIL=admin@example.com

# Brand (used in emails / invoices)
BRAND_NAME=Elvee

# Payment
PAYMENT_GATEWAY=fake
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
