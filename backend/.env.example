# Server
NODE_ENV=development
PORT=3001

# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Frontend (for emails, redirects)
FRONTEND_URL=http://localhost:3000

# Mail
